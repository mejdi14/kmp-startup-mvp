# Client-side configuration reference for the KMP app.
#
# NOTE: the build does NOT read this file. These values are compiled into
# kmp/sharedLogic/src/commonMain/kotlin/com/mejdi14/kmpstartupmvp/config/SupabaseConfig.kt
# (LOCAL and HOSTED). This file documents the two keys and where each one comes
# from, so you know what to paste into SupabaseConfig.kt for your own project.
#
# Both values are PUBLIC by design (the anon key is protected by RLS), which is
# why the Flutter app also committed flutter/env.json and flutter/env.local.json.
# NEVER put a service-role key, Stripe secret, or any other server secret here.

# --- Local Supabase (debug builds: Android debug / Xcode Debug) -------------
# `supabase start` prints the URL and anon key. These are the stock demo values.
LOCAL_SUPABASE_URL=http://localhost:54321
LOCAL_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Hosted Supabase (release builds) ---------------------------------------
# Dashboard -> Project Settings -> API -> Project URL / anon public key.
HOSTED_SUPABASE_URL=https://<your-project-ref>.supabase.co
HOSTED_SUPABASE_ANON_KEY=<your-anon-public-key>

# --- Google sign-in (optional; empty disables it with a clear error) --------
# These ARE read by the build, but from other places, not from this file:
#   Android: GOOGLE_WEB_CLIENT_ID in ~/.gradle/gradle.properties (or -PGOOGLE_WEB_CLIENT_ID=...)
#   iOS:     GOOGLE_IOS_CLIENT_ID / GOOGLE_WEB_CLIENT_ID / GOOGLE_REVERSED_CLIENT_ID
#            in kmp/iosApp/Configuration/Config.xcconfig
# The web client ID is the one registered in Supabase's Google provider.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_REVERSED_CLIENT_ID=
